# ==============================================================================
# CAREEROS ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and provide your secret keys. DO NOT commit .env to source control.
# ==============================================================================

# 1. Search & Scraping
SERPER_API_KEY=
TAVILY_API_KEY=

# 2. Telegram Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 3. Turso Database (LibSQL)
TURSO_DB_URL=
TURSO_AUTH_TOKEN=

# 4. LLM Providers
# Fireworks (check your provider account for current availability and pricing)
FIREWORKS_API_KEY=
LLM_MODEL=accounts/fireworks/models/deepseek-v4p1-flash
LLM_PROVIDER=fireworks

# Google Gemini (optional)
GEMINI_API_KEY=

# Anthropic Claude (optional)
ANTHROPIC_API_KEY=

# 5. Dashboard Security
DASHBOARD_PASSWORD=

# 6. Observability & Tracing (Langfuse)
# Default: false. Set to true to enable centralized LLM judge tracing.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
